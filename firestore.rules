rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isOwnedPublicProfile(profileId) {
      return signedIn()
        && (profileId == request.auth.uid
          || profileId.matches(request.auth.uid + '_.*'));
    }

    function ownsUsername(username) {
      return signedIn()
        && exists(/databases/$(database)/documents/usernames/$(username))
        && get(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid;
    }

    function validGuestbookPasswordEdit(entryId) {
      let challenge = getAfter(/databases/$(database)/documents/guestbookEditChallenges/$(request.resource.data.editChallengeId));
      return resource.data.hasEditPassword == true
        && request.resource.data.editChallengeId is string
        && challenge.data.entryId == entryId
        && challenge.data.targetUsername == resource.data.targetUsername
        && challenge.data.authorName == request.resource.data.authorName
        && challenge.data.content == request.resource.data.content
        && challenge.data.isSecret == request.resource.data.isSecret;
    }

    function validGuestbookReplyPasswordEdit(replyId) {
      let challenge = getAfter(/databases/$(database)/documents/guestbookReplyEditChallenges/$(request.resource.data.editChallengeId));
      return resource.data.hasEditPassword == true
        && request.resource.data.editChallengeId is string
        && challenge.data.replyId == replyId
        && challenge.data.targetUsername == resource.data.targetUsername
        && challenge.data.authorName == request.resource.data.authorName
        && challenge.data.content == request.resource.data.content;
    }

    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);

      match /collected_customer_data/{entryId} {
        allow create: if request.resource.data.keys().hasOnly([
          'blockId', 'email', 'phone', 'name', 'createdAt'
        ]) && request.resource.data.blockId is string;
        allow read, delete: if isOwner(uid);
        allow update: if false;
      }
    }

    match /publicProfiles/{profileId} {
      allow read: if true;
      allow create, update, delete: if isOwnedPublicProfile(profileId);
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /analytics/{uid} {
      allow read: if isOwner(uid);
      allow create: if request.resource.data.pageViews == 1;
      allow update: if isOwner(uid) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pageViews'])
        && request.resource.data.pageViews == resource.data.pageViews + 1
      );

      match /daily/{date} {
        allow read, delete: if isOwner(uid);
        allow create: if request.resource.data.date == date
          && ((request.resource.data.views == 1 && request.resource.data.clicks == 0)
            || (request.resource.data.views == 0 && request.resource.data.clicks == 1));
        allow update: if isOwner(uid) || (
          request.resource.data.date == resource.data.date
          && ((request.resource.data.views == resource.data.views + 1
              && request.resource.data.clicks == resource.data.clicks)
            || (request.resource.data.clicks == resource.data.clicks + 1
              && request.resource.data.views == resource.data.views))
        );
      }

      match /links/{linkId} {
        allow read, delete: if isOwner(uid);
        allow create: if request.resource.data.linkId == linkId
          && request.resource.data.clicks == 1;
        allow update: if isOwner(uid) || (
          request.resource.data.linkId == resource.data.linkId
          && request.resource.data.clicks == resource.data.clicks + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'updatedAt'])
        );
      }
    }

    match /guestbooks/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
        'targetUsername', 'targetOwnerUid', 'authorName', 'authorUid', 'content',
        'isSecret', 'likes', 'isHidden', 'hasEditPassword', 'createdAt'
      ])
        && request.resource.data.targetUsername is string
        && request.resource.data.targetOwnerUid is string
        && exists(/databases/$(database)/documents/usernames/$(request.resource.data.targetUsername))
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.targetUsername)).data.uid == request.resource.data.targetOwnerUid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 50
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000
        && request.resource.data.likes == 0
        && request.resource.data.isHidden == false
        && ((signedIn()
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.hasEditPassword == false)
          || (!signedIn()
            && request.resource.data.authorUid == null
            && request.resource.data.hasEditPassword == true));
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authorName', 'content', 'isSecret', 'isHidden', 'updatedAt', 'editChallengeId'
        ])
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 50
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000
        && (
          (ownsUsername(resource.data.targetUsername)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isHidden', 'updatedAt'
            ]))
          || (signedIn()
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'authorName', 'content', 'isSecret', 'updatedAt'
            ]))
          || (request.resource.data.keys().hasAll(['editChallengeId'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'authorName', 'content', 'isSecret', 'updatedAt', 'editChallengeId'
            ])
            && (resource.data.authorName != '익명'
              || request.resource.data.authorName == resource.data.authorName)
            && validGuestbookPasswordEdit(entryId))
        );
      allow delete: if ownsUsername(resource.data.targetUsername)
        || (signedIn() && resource.data.authorUid == request.auth.uid)
        || (resource.data.hasEditPassword == true
          && getAfter(/databases/$(database)/documents/guestbookDeleteChallenges/$(entryId)).data.entryId == entryId
          && getAfter(/databases/$(database)/documents/guestbookDeleteChallenges/$(entryId)).data.targetUsername == resource.data.targetUsername);
    }

    match /guestbookSecrets/{entryId} {
      allow read: if false;
      allow create: if !signedIn()
        && request.resource.data.keys().hasOnly(['targetUsername', 'passwordHash', 'createdAt'])
        && request.resource.data.targetUsername is string
        && request.resource.data.passwordHash is string
        && request.resource.data.passwordHash.size() == 64
        && getAfter(/databases/$(database)/documents/guestbooks/$(entryId)).data.targetUsername == request.resource.data.targetUsername
        && getAfter(/databases/$(database)/documents/guestbooks/$(entryId)).data.hasEditPassword == true;
      allow update: if false;
      allow delete: if ownsUsername(resource.data.targetUsername)
        || (getAfter(/databases/$(database)/documents/guestbookDeleteChallenges/$(entryId)).data.targetUsername == resource.data.targetUsername
          && getAfter(/databases/$(database)/documents/guestbookDeleteChallenges/$(entryId)).data.passwordHash == resource.data.passwordHash);
    }

    match /guestbookEditChallenges/{challengeId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly([
          'entryId', 'targetUsername', 'passwordHash', 'authorName', 'content', 'isSecret', 'createdAt'
        ])
        && request.resource.data.entryId is string
        && request.resource.data.targetUsername is string
        && request.resource.data.passwordHash is string
        && request.resource.data.passwordHash.size() == 64
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 50
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000
        && get(/databases/$(database)/documents/guestbookSecrets/$(request.resource.data.entryId)).data.targetUsername == request.resource.data.targetUsername
        && get(/databases/$(database)/documents/guestbookSecrets/$(request.resource.data.entryId)).data.passwordHash == request.resource.data.passwordHash;
      allow update, delete: if false;
    }

    match /guestbookDeleteChallenges/{entryId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly([
          'entryId', 'targetUsername', 'passwordHash', 'createdAt'
        ])
        && request.resource.data.entryId == entryId
        && request.resource.data.targetUsername is string
        && request.resource.data.passwordHash is string
        && request.resource.data.passwordHash.size() == 64
        && get(/databases/$(database)/documents/guestbookSecrets/$(entryId)).data.targetUsername == request.resource.data.targetUsername
        && get(/databases/$(database)/documents/guestbookSecrets/$(entryId)).data.passwordHash == request.resource.data.passwordHash;
      allow update, delete: if false;
    }

    match /guestbookReplySecrets/{replyId} {
      allow read: if false;
      allow create: if !signedIn()
        && request.resource.data.keys().hasOnly(['targetUsername', 'passwordHash', 'createdAt'])
        && request.resource.data.targetUsername is string
        && request.resource.data.passwordHash is string
        && request.resource.data.passwordHash.size() == 64
        && getAfter(/databases/$(database)/documents/guestbookReplies/$(replyId)).data.targetUsername == request.resource.data.targetUsername
        && getAfter(/databases/$(database)/documents/guestbookReplies/$(replyId)).data.hasEditPassword == true;
      allow update: if false;
      allow delete: if ownsUsername(resource.data.targetUsername)
        || (getAfter(/databases/$(database)/documents/guestbookReplyDeleteChallenges/$(replyId)).data.targetUsername == resource.data.targetUsername
          && getAfter(/databases/$(database)/documents/guestbookReplyDeleteChallenges/$(replyId)).data.passwordHash == resource.data.passwordHash);
    }

    match /guestbookReplyEditChallenges/{challengeId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly([
          'replyId', 'targetUsername', 'passwordHash', 'authorName', 'content', 'createdAt'
        ])
        && request.resource.data.replyId is string
        && request.resource.data.targetUsername is string
        && request.resource.data.passwordHash is string
        && request.resource.data.passwordHash.size() == 64
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 50
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000
        && get(/databases/$(database)/documents/guestbookReplySecrets/$(request.resource.data.replyId)).data.targetUsername == request.resource.data.targetUsername
        && get(/databases/$(database)/documents/guestbookReplySecrets/$(request.resource.data.replyId)).data.passwordHash == request.resource.data.passwordHash;
      allow update, delete: if false;
    }

    match /guestbookReplyDeleteChallenges/{replyId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly([
          'replyId', 'targetUsername', 'passwordHash', 'createdAt'
        ])
        && request.resource.data.replyId == replyId
        && request.resource.data.targetUsername is string
        && request.resource.data.passwordHash is string
        && request.resource.data.passwordHash.size() == 64
        && get(/databases/$(database)/documents/guestbookReplySecrets/$(replyId)).data.targetUsername == request.resource.data.targetUsername
        && get(/databases/$(database)/documents/guestbookReplySecrets/$(replyId)).data.passwordHash == request.resource.data.passwordHash;
      allow update, delete: if false;
    }

    match /guestbookReplies/{replyId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
        'entryId', 'targetUsername', 'authorUid', 'authorPhotoUrl', 'authorName',
        'content', 'hasEditPassword', 'createdAt'
      ])
        && request.resource.data.entryId is string
        && request.resource.data.targetUsername is string
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 50
        && ((signedIn()
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.hasEditPassword == false)
          || (!signedIn()
            && request.resource.data.authorUid == null
            && request.resource.data.hasEditPassword == true))
        && (request.resource.data.authorPhotoUrl == null || request.resource.data.authorPhotoUrl is string)
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authorUid', 'authorPhotoUrl', 'authorName', 'content', 'updatedAt', 'editChallengeId'
        ])
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 50
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000
        && (
          (ownsUsername(resource.data.targetUsername)
            && (!resource.data.keys().hasAll(['authorUid']) || resource.data.authorUid == null)
            && request.resource.data.authorUid == request.auth.uid
            && (request.resource.data.authorPhotoUrl == null || request.resource.data.authorPhotoUrl is string)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorUid', 'authorPhotoUrl']))
          || (signedIn()
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'authorName', 'content', 'updatedAt'
            ]))
          || (request.resource.data.keys().hasAll(['editChallengeId'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'authorName', 'content', 'updatedAt', 'editChallengeId'
            ])
            && (resource.data.authorName != '익명'
              || request.resource.data.authorName == resource.data.authorName)
            && validGuestbookReplyPasswordEdit(replyId))
        );
      allow delete: if ownsUsername(resource.data.targetUsername)
        || (signedIn() && resource.data.authorUid == request.auth.uid)
        || (resource.data.hasEditPassword == true
          && getAfter(/databases/$(database)/documents/guestbookReplyDeleteChallenges/$(replyId)).data.replyId == replyId
          && getAfter(/databases/$(database)/documents/guestbookReplyDeleteChallenges/$(replyId)).data.targetUsername == resource.data.targetUsername)
        || !existsAfter(/databases/$(database)/documents/guestbooks/$(resource.data.entryId));
    }
  }
}
