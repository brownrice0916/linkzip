rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSiteAdmin() {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') == 'brownrice0916@gmail.com';
    }

    function paidMembershipActive(uid) {
      // Accounts created before plan fields were introduced are Basic users.
      // Reading a missing map field directly makes the whole rule evaluation
      // fail, which previously blocked every profile save for those accounts.
      return exists(/databases/$(database)/documents/users/$(uid))
        && (
          get(/databases/$(database)/documents/users/$(uid)).data.get('membershipGrant', '') == 'beta_lifetime_premium'
          || (
            get(/databases/$(database)/documents/users/$(uid)).data.get('membershipPlan', 'basic') in ['standard', 'premium']
            && get(/databases/$(database)/documents/users/$(uid)).data.get('membershipPeriodEndsAt', request.time) is timestamp
            && get(/databases/$(database)/documents/users/$(uid)).data.get('membershipPeriodEndsAt', request.time) > request.time
          )
        );
    }

    function premiumMembershipActive(uid) {
      return paidMembershipActive(uid)
        && (
          get(/databases/$(database)/documents/users/$(uid)).data.get('membershipGrant', '') == 'beta_lifetime_premium'
          || get(/databases/$(database)/documents/users/$(uid)).data.get('membershipPlan', 'basic') == 'premium'
        );
    }

    function currentProfileLimit(uid) {
      return premiumMembershipActive(uid) ? 5 : (paidMembershipActive(uid) ? 3 : 1);
    }

    function validProfileWorkspaceCount(uid) {
      return !request.resource.data.keys().hasAny(['profileWorkspaces'])
        || (request.resource.data.profileWorkspaces is list
          && (request.resource.data.profileWorkspaces.size() <= currentProfileLimit(uid)
            || (resource != null
              && resource.data.profileWorkspaces is list
              && request.resource.data.profileWorkspaces.size() <= resource.data.profileWorkspaces.size())));
    }

    function membershipFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'membershipPlan', 'membershipBillingCycle', 'membershipPeriodStartedAt',
        'membershipPeriodEndsAt', 'membershipPaymentProvider', 'membershipUpdatedAt',
        'membershipPaidAmount', 'membershipLastOrderNumber', 'membershipGrant',
        'membershipGrantedAt', 'sellerVerification'
      ]);
    }

    function hasBetaAccess() {
      return signedIn() && (
        (!exists(/databases/$(database)/documents/betaMembers/$(request.auth.uid))
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        || (exists(/databases/$(database)/documents/betaMembers/$(request.auth.uid))
          && get(/databases/$(database)/documents/betaMembers/$(request.auth.uid)).data.status == 'active')
      );
    }

    function ownsUsername(username) {
      return signedIn()
        && exists(/databases/$(database)/documents/usernames/$(username))
        && get(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid;
    }

    function validGuestbookPasswordEdit(entryId) {
      let challenge = getAfter(/databases/$(database)/documents/guestbookEditChallenges/$(request.resource.data.editChallengeId));
      return resource.data.hasEditPassword == true
        && request.resource.data.editChallengeId is string
        && challenge.data.entryId == entryId
        && challenge.data.targetUsername == resource.data.targetUsername
        && challenge.data.authorName == request.resource.data.authorName
        && challenge.data.content == request.resource.data.content
        && challenge.data.isSecret == request.resource.data.isSecret;
    }

    function validGuestbookReplyPasswordEdit(replyId) {
      let challenge = getAfter(/databases/$(database)/documents/guestbookReplyEditChallenges/$(request.resource.data.editChallengeId));
      return resource.data.hasEditPassword == true
        && request.resource.data.editChallengeId is string
        && challenge.data.replyId == replyId
        && challenge.data.targetUsername == resource.data.targetUsername
        && challenge.data.authorName == request.resource.data.authorName
        && challenge.data.content == request.resource.data.content;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) && hasBetaAccess();
      // Account deletion must run through the server so authentication, nested
      // documents, public profiles, OAuth identities and uploaded files are
      // removed together instead of leaving a partially deleted account.
      allow delete: if false;
      allow create: if isOwner(uid) && hasBetaAccess()
        && !request.resource.data.keys().hasAny([
          'membershipPlan', 'membershipBillingCycle', 'membershipPeriodStartedAt',
          'membershipPeriodEndsAt', 'membershipPaymentProvider', 'membershipUpdatedAt',
          'membershipPaidAmount', 'membershipLastOrderNumber', 'membershipGrant',
          'membershipGrantedAt', 'sellerVerification'
        ])
        && validProfileWorkspaceCount(uid);
      allow update: if isOwner(uid) && hasBetaAccess()
        && membershipFieldsUnchanged()
        && validProfileWorkspaceCount(uid);

      match /collected_customer_data/{entryId} {
        allow create: if false;
        allow read: if false;
        allow delete: if false;
        allow update: if false;
      }

      match /anonymous_messages/{messageId} {
        allow create: if request.resource.data.keys().hasOnly([
            'blockId', 'targetUsername', 'content', 'isRead', 'createdAt'
          ])
          && request.resource.data.blockId is string
          && request.resource.data.targetUsername is string
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1000
          && request.resource.data.isRead == false
          && exists(/databases/$(database)/documents/usernames/$(request.resource.data.targetUsername))
          && get(/databases/$(database)/documents/usernames/$(request.resource.data.targetUsername)).data.uid == uid;
        allow read, update, delete: if isOwner(uid);
      }

      match /sales_orders/{orderId} {
        allow create: if false;
        allow read, delete: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'fulfillmentStatus', 'carrier', 'trackingNumber'
          ])
          && request.resource.data.status in ['pending', 'paid', 'cancelled']
          && request.resource.data.get('fulfillmentStatus', 'payment_pending') in [
            'payment_pending', 'preparing', 'shipping', 'delivered'
          ]
          && request.resource.data.get('carrier', '') is string
          && request.resource.data.get('carrier', '').size() <= 30
          && request.resource.data.get('trackingNumber', '') is string
          && request.resource.data.get('trackingNumber', '').size() <= 50;
      }

      match /donations/{donationId} {
        allow read: if isOwner(uid);
        allow create: if false;
        allow update, delete: if isOwner(uid);
      }

      match /publicDonations/{donationId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /publicProfiles/{profileId} {
      allow read: if true;
      // Ownership is stored in the document instead of inferred from its ID.
      // This also supports custom-auth UIDs such as "naver:..." and
      // "kakao:..." without relying on a dynamic regular expression.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && hasBetaAccess()
        && !request.resource.data.keys().hasAny(['planPaused', 'forceWatermark']);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && hasBetaAccess()
        && request.resource.data.get('planPaused', false) == resource.data.get('planPaused', false)
        && request.resource.data.get('forceWatermark', false) == resource.data.get('forceWatermark', false);
      allow delete: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || profileId == request.auth.uid)
        && hasBetaAccess();
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() && hasBetaAccess() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && hasBetaAccess()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && hasBetaAccess() && resource.data.uid == request.auth.uid;
    }

    match /betaMembers/{uid} {
      allow read, write: if false;
    }

    match /betaInviteCodes/{codeId} {
      allow read, write: if false;
    }

    // A report carries up to 5 screenshots in attachmentUrls. Reports written
    // before that field existed keep their single attachmentUrl, so both are
    // optional here and the client reads whichever is present.
    function validBugReportImages() {
      return !('attachmentUrls' in request.resource.data)
        || (request.resource.data.attachmentUrls is list
          && request.resource.data.attachmentUrls.size() <= 5);
    }

    match /bugReports/{reportId} {
      allow create: if hasBetaAccess()
        && validBugReportImages()
        && request.resource.data.keys().hasOnly([
          'uid', 'reporterName', 'category', 'title', 'description',
          'reproductionSteps', 'expectedResult', 'actualResult',
          'attachmentUrl', 'attachmentUrls', 'cardColor', 'status', 'visibilityVersion', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 2000
        && request.resource.data.category in ['버그', '개선사항', '건의사항', '기타']
        && request.resource.data.reproductionSteps is string
        && request.resource.data.reproductionSteps.size() <= 2000
        && request.resource.data.cardColor is string
        && request.resource.data.cardColor.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.visibilityVersion == 2
        && request.resource.data.status == 'new';
      allow read: if hasBetaAccess() && resource.data.get('visibilityVersion', 0) == 2;
      allow update: if hasBetaAccess()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'category', 'attachmentUrl', 'attachmentUrls', 'updatedAt'])
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 2000
        && request.resource.data.category in ['버그', '개선사항', '건의사항', '기타']
        && request.resource.data.attachmentUrl is string
        && validBugReportImages();
      allow update: if isSiteAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'in_progress', 'resolved'];
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;

      match /replies/{replyId} {
        allow read: if hasBetaAccess();
        allow create: if hasBetaAccess()
          && request.resource.data.keys().hasOnly(['uid', 'authorName', 'message', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 50
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 1000;
        allow update: if false;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    match /bugReportPrivate/{reportId} {
      allow create: if hasBetaAccess()
        && request.resource.data.keys().hasOnly([
          'uid', 'reporterEmail', 'sourceUrl', 'userAgent', 'viewport', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isSiteAdmin());
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /analytics/{uid} {
      allow read: if isOwner(uid);
      allow create: if request.resource.data.pageViews == 1;
      allow update: if isOwner(uid) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pageViews'])
        && request.resource.data.pageViews == resource.data.pageViews + 1
      );

      match /daily/{date} {
        allow read, delete: if isOwner(uid);
        allow create: if request.resource.data.date == date
          && ((request.resource.data.views == 1 && request.resource.data.clicks == 0)
            || (request.resource.data.views == 0
              && request.resource.data.clicks == 1
              && request.resource.data.linkClicks is map
              && request.resource.data.linkClicks.size() == 1));
        allow update: if isOwner(uid) || (
          request.resource.data.date == resource.data.date
          && ((request.resource.data.views == resource.data.views + 1
              && request.resource.data.clicks == resource.data.clicks)
            || (request.resource.data.clicks == resource.data.clicks + 1
              && request.resource.data.views == resource.data.views
              && request.resource.data.linkClicks is map
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'linkClicks'])))
        );
      }

      match /links/{linkId} {
        allow read, delete: if isOwner(uid);
        allow create: if request.resource.data.linkId == linkId
          && request.resource.data.clicks == 1;
        allow update: if isOwner(uid) || (
          request.resource.data.linkId == resource.data.linkId
          && request.resource.data.clicks == resource.data.clicks + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'updatedAt'])
        );
      }
    }

    match /guestbooks/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
        'targetUsername', 'targetOwnerUid', 'authorName', 'authorUid', 'content',
        'isSecret', 'likes', 'isHidden', 'hasEditPassword', 'createdAt'
      ])
        && request.resource.data.targetUsername is string
        && request.resource.data.targetOwnerUid is string
        && exists(/databases/$(database)/documents/usernames/$(request.resource.data.targetUsername))
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.targetUsername)).data.uid == request.resource.data.targetOwnerUid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 50
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000
        && request.resource.data.likes == 0
        && request.resource.data.isHidden == false
        && ((signedIn()
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.hasEditPassword == false)
          || (!signedIn()
            && request.resource.data.authorUid == null
            && request.resource.data.hasEditPassword == true));
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authorName', 'content', 'isSecret', 'isHidden', 'updatedAt', 'editChallengeId'
        ])
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 50
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000
        && (
          (ownsUsername(resource.data.targetUsername)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isHidden', 'updatedAt'
            ]))
          || (signedIn()
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'authorName', 'content', 'isSecret', 'updatedAt'
            ]))
          || (request.resource.data.keys().hasAll(['editChallengeId'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'authorName', 'content', 'isSecret', 'updatedAt', 'editChallengeId'
            ])
            && (resource.data.authorName != '익명'
              || request.resource.data.authorName == resource.data.authorName)
            && validGuestbookPasswordEdit(entryId))
        );
      allow delete: if ownsUsername(resource.data.targetUsername)
        || (signedIn() && resource.data.authorUid == request.auth.uid)
        || (resource.data.hasEditPassword == true
          && getAfter(/databases/$(database)/documents/guestbookDeleteChallenges/$(entryId)).data.entryId == entryId
          && getAfter(/databases/$(database)/documents/guestbookDeleteChallenges/$(entryId)).data.targetUsername == resource.data.targetUsername);
    }

    match /guestbookSecrets/{entryId} {
      allow read: if false;
      allow create: if !signedIn()
        && request.resource.data.keys().hasOnly(['targetUsername', 'passwordHash', 'createdAt'])
        && request.resource.data.targetUsername is string
        && request.resource.data.passwordHash is string
        && request.resource.data.passwordHash.size() == 64
        && getAfter(/databases/$(database)/documents/guestbooks/$(entryId)).data.targetUsername == request.resource.data.targetUsername
        && getAfter(/databases/$(database)/documents/guestbooks/$(entryId)).data.hasEditPassword == true;
      allow update: if false;
      allow delete: if ownsUsername(resource.data.targetUsername)
        || (getAfter(/databases/$(database)/documents/guestbookDeleteChallenges/$(entryId)).data.targetUsername == resource.data.targetUsername
          && getAfter(/databases/$(database)/documents/guestbookDeleteChallenges/$(entryId)).data.passwordHash == resource.data.passwordHash);
    }

    match /guestbookEditChallenges/{challengeId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly([
          'entryId', 'targetUsername', 'passwordHash', 'authorName', 'content', 'isSecret', 'createdAt'
        ])
        && request.resource.data.entryId is string
        && request.resource.data.targetUsername is string
        && request.resource.data.passwordHash is string
        && request.resource.data.passwordHash.size() == 64
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 50
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000
        && get(/databases/$(database)/documents/guestbookSecrets/$(request.resource.data.entryId)).data.targetUsername == request.resource.data.targetUsername
        && get(/databases/$(database)/documents/guestbookSecrets/$(request.resource.data.entryId)).data.passwordHash == request.resource.data.passwordHash;
      allow update, delete: if false;
    }

    match /guestbookDeleteChallenges/{entryId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly([
          'entryId', 'targetUsername', 'passwordHash', 'createdAt'
        ])
        && request.resource.data.entryId == entryId
        && request.resource.data.targetUsername is string
        && request.resource.data.passwordHash is string
        && request.resource.data.passwordHash.size() == 64
        && get(/databases/$(database)/documents/guestbookSecrets/$(entryId)).data.targetUsername == request.resource.data.targetUsername
        && get(/databases/$(database)/documents/guestbookSecrets/$(entryId)).data.passwordHash == request.resource.data.passwordHash;
      allow update, delete: if false;
    }

    match /guestbookReplySecrets/{replyId} {
      allow read: if false;
      allow create: if !signedIn()
        && request.resource.data.keys().hasOnly(['targetUsername', 'passwordHash', 'createdAt'])
        && request.resource.data.targetUsername is string
        && request.resource.data.passwordHash is string
        && request.resource.data.passwordHash.size() == 64
        && getAfter(/databases/$(database)/documents/guestbookReplies/$(replyId)).data.targetUsername == request.resource.data.targetUsername
        && getAfter(/databases/$(database)/documents/guestbookReplies/$(replyId)).data.hasEditPassword == true;
      allow update: if false;
      allow delete: if ownsUsername(resource.data.targetUsername)
        || (getAfter(/databases/$(database)/documents/guestbookReplyDeleteChallenges/$(replyId)).data.targetUsername == resource.data.targetUsername
          && getAfter(/databases/$(database)/documents/guestbookReplyDeleteChallenges/$(replyId)).data.passwordHash == resource.data.passwordHash);
    }

    match /guestbookReplyEditChallenges/{challengeId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly([
          'replyId', 'targetUsername', 'passwordHash', 'authorName', 'content', 'createdAt'
        ])
        && request.resource.data.replyId is string
        && request.resource.data.targetUsername is string
        && request.resource.data.passwordHash is string
        && request.resource.data.passwordHash.size() == 64
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 50
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000
        && get(/databases/$(database)/documents/guestbookReplySecrets/$(request.resource.data.replyId)).data.targetUsername == request.resource.data.targetUsername
        && get(/databases/$(database)/documents/guestbookReplySecrets/$(request.resource.data.replyId)).data.passwordHash == request.resource.data.passwordHash;
      allow update, delete: if false;
    }

    match /guestbookReplyDeleteChallenges/{replyId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly([
          'replyId', 'targetUsername', 'passwordHash', 'createdAt'
        ])
        && request.resource.data.replyId == replyId
        && request.resource.data.targetUsername is string
        && request.resource.data.passwordHash is string
        && request.resource.data.passwordHash.size() == 64
        && get(/databases/$(database)/documents/guestbookReplySecrets/$(replyId)).data.targetUsername == request.resource.data.targetUsername
        && get(/databases/$(database)/documents/guestbookReplySecrets/$(replyId)).data.passwordHash == request.resource.data.passwordHash;
      allow update, delete: if false;
    }

    match /guestbookReplies/{replyId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
        'entryId', 'targetUsername', 'authorUid', 'authorPhotoUrl', 'authorName',
        'content', 'hasEditPassword', 'createdAt'
      ])
        && request.resource.data.entryId is string
        && request.resource.data.targetUsername is string
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 50
        && ((signedIn()
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.hasEditPassword == false)
          || (!signedIn()
            && request.resource.data.authorUid == null
            && request.resource.data.hasEditPassword == true))
        && (request.resource.data.authorPhotoUrl == null || request.resource.data.authorPhotoUrl is string)
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authorUid', 'authorPhotoUrl', 'authorName', 'content', 'updatedAt', 'editChallengeId'
        ])
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 50
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000
        && (
          (ownsUsername(resource.data.targetUsername)
            && (!resource.data.keys().hasAll(['authorUid']) || resource.data.authorUid == null)
            && request.resource.data.authorUid == request.auth.uid
            && (request.resource.data.authorPhotoUrl == null || request.resource.data.authorPhotoUrl is string)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorUid', 'authorPhotoUrl']))
          || (signedIn()
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'authorName', 'content', 'updatedAt'
            ]))
          || (request.resource.data.keys().hasAll(['editChallengeId'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'authorName', 'content', 'updatedAt', 'editChallengeId'
            ])
            && (resource.data.authorName != '익명'
              || request.resource.data.authorName == resource.data.authorName)
            && validGuestbookReplyPasswordEdit(replyId))
        );
      allow delete: if ownsUsername(resource.data.targetUsername)
        || (signedIn() && resource.data.authorUid == request.auth.uid)
        || (resource.data.hasEditPassword == true
          && getAfter(/databases/$(database)/documents/guestbookReplyDeleteChallenges/$(replyId)).data.replyId == replyId
          && getAfter(/databases/$(database)/documents/guestbookReplyDeleteChallenges/$(replyId)).data.targetUsername == resource.data.targetUsername)
        || !existsAfter(/databases/$(database)/documents/guestbooks/$(resource.data.entryId));
    }
  }
}
