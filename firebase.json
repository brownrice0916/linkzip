{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/meta/instagram/webhook",
        "function": {
          "functionId": "metaInstagramWebhook",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/auth/instagram/callback",
        "function": {
          "functionId": "instagramOAuthCallback",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
